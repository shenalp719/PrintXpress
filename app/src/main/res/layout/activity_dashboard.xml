<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A10">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomNavigationView">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PRINT XPRESS"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#00E5FF"
                android:letterSpacing="0.1"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STATUS: SECURE_CONNECTION_ACTIVE"
                android:textSize="11sp"
                android:textColor="#FF003C"
                android:layout_marginBottom="24dp"/>

            <!-- ROW 1: Business Cards & Stickers -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnBusinessCards"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="Business Cards"
                    android:textColor="#00E5FF"
                    android:background="@drawable/cyber_card_bg"
                    android:drawableTop="@drawable/icon_cards"
                    android:paddingTop="20dp"
                    android:textStyle="bold"/>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnStickers"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="Stickers"
                    android:textColor="#9D00FF"
                    android:background="@drawable/cyber_card_bg"
                    android:drawableTop="@drawable/icon_stickers"
                    android:paddingTop="20dp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- ROW 2: Flyers & Posters -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnFlyers"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="Flyers"
                    android:textColor="#FF003C"
                    android:background="@drawable/cyber_card_bg"
                    android:drawableTop="@drawable/icon_flyers"
                    android:paddingTop="20dp"
                    android:textStyle="bold"/>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnPosters"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="Posters"
                    android:textColor="#00E5FF"
                    android:background="@drawable/cyber_card_bg"
                    android:drawableTop="@drawable/icon_posters"
                    android:paddingTop="20dp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- ROW 3: Custom Mugs & Custom T-Shirts -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnMugs"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="Custom Mugs"
                    android:textColor="#9D00FF"
                    android:background="@drawable/cyber_card_bg"
                    android:drawableTop="@drawable/icon_mugs"
                    android:paddingTop="20dp"
                    android:textStyle="bold"/>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnTshirts"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="Custom T-Shirts"
                    android:textColor="#FF003C"
                    android:background="@drawable/cyber_card_bg"
                    android:drawableTop="@drawable/icon_tshirts"
                    android:paddingTop="20dp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- ROW 4: Banners (Full Width) -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnBanners"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:text="Banners"
                android:textColor="#00E5FF"
                android:background="@drawable/cyber_card_bg"
                android:drawableTop="@drawable/icon_banners"
                android:paddingTop="20dp"
                android:layout_marginBottom="24dp"
                android:textStyle="bold"/>

            <!-- Action Buttons -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnGallery"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="ACCESS DESIGN GALLERY"
                android:background="@drawable/cyber_card_bg"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="12dp"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSupport"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="SUPPORT PROTOCOLS &amp; FAQ"
                android:background="@drawable/cyber_card_bg"
                android:textColor="#FFFFFF"/>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#161625"
        app:itemIconTint="#00E5FF"
        app:itemTextColor="#00E5FF"
        app:menu="@menu/bottom_nav_menu" />

</RelativeLayout>