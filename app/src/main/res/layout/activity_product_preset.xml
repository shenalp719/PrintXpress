<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A10">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvProductTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Business Cards"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#00E5FF"
                android:layout_marginBottom="24dp"/>

            <!-- Preset Image Placeholder -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:src="@android:drawable/ic_menu_gallery"
                android:background="#161625"
                android:scaleType="centerInside"
                android:layout_marginBottom="16dp"/>

            <!-- Preset Details -->
            <TextView
                android:id="@+id/tvPresetName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Classic Business Card"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvPresetPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Rs. 1,500"
                android:textSize="18sp"
                android:textColor="#FF003C"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvPresetSpecs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Size: 90 x 54 mm\nPaper: 300 GSM\nFinish: Matte"
                android:textSize="16sp"
                android:textColor="#AAAAAA"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="24dp"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSelectPreset"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SELECT PRESET"
                android:textColor="#000000"
                android:backgroundTint="#00E5FF"
                android:padding="12dp"
                android:textStyle="bold"/>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>