<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A10">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomNavigationView">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp"
            android:paddingTop="60dp"
            android:gravity="center_horizontal">

            <!-- Clickable Profile Picture -->
            <ImageView
                android:id="@+id/ivProfilePic"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@android:drawable/ic_menu_myplaces"
                android:background="@drawable/cyber_card_bg"
                android:scaleType="centerCrop"
                android:padding="4dp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap avatar to change photo"
                android:textColor="#888888"
                android:textSize="12sp"
                android:layout_marginBottom="24dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="My Profile"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#00E5FF"
                android:layout_marginBottom="24dp"/>

            <!-- Email Field -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp"
                android:background="#161625"
                android:padding="4dp">

                <TextView
                    android:id="@+id/tvEmail"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Email: "
                    android:textSize="16sp"
                    android:textColor="#FFFFFF"
                    android:padding="12dp" />

                <ImageButton
                    android:id="@+id/btnEditEmail"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@android:drawable/ic_menu_edit"
                    android:background="?attr/selectableItemBackground"
                    app:tint="#FF003C" />
            </LinearLayout>

            <EditText
                android:id="@+id/etName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Full Name"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:inputType="textPersonName"
                android:padding="16dp"
                android:background="#161625"
                android:layout_marginBottom="16dp"/>

            <EditText
                android:id="@+id/etPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Phone Number"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:inputType="phone"
                android:padding="16dp"
                android:background="#161625"
                android:layout_marginBottom="16dp"/>

            <EditText
                android:id="@+id/etAddress"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:hint="Delivery Address"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:gravity="top|left"
                android:inputType="textMultiLine"
                android:padding="16dp"
                android:background="#161625"
                android:layout_marginBottom="32dp"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSaveProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Save Profile"
                android:textColor="#000000"
                android:padding="12dp"
                android:backgroundTint="#00E5FF"
                android:layout_marginBottom="16dp"
                android:textStyle="bold"/>

            <!-- View Saved Designs Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnViewSavedDesigns"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="View Saved Designs"
                android:textColor="#9D00FF"
                android:background="@drawable/cyber_card_bg"
                android:drawableStart="@android:drawable/ic_menu_agenda"
                android:drawableTint="#9D00FF"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:layout_marginBottom="16dp"
                android:textStyle="bold"/>

            <!-- Logout Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Logout Session"
                android:textColor="#FF003C"
                android:background="@drawable/cyber_card_bg"
                android:drawableStart="@android:drawable/ic_lock_power_off"
                android:drawableTint="#FF003C"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:layout_marginBottom="24dp"
                android:textStyle="bold"/>

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#161625"
        app:itemIconTint="#00E5FF"
        app:itemTextColor="#00E5FF"
        app:menu="@menu/bottom_nav_menu" />

</RelativeLayout>