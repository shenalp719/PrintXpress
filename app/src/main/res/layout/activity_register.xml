<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0A10"
    android:padding="32dp"
    android:gravity="center">

    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/app_logo"
        android:layout_marginBottom="16dp"
        android:layout_marginTop="24dp"
        android:scaleType="fitCenter"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NEW USER REGISTRATION"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#9D00FF"
        android:layout_marginBottom="32dp"/>

    <EditText
        android:id="@+id/etRegEmail"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:hint="Email or Phone Number"
        android:textColor="#FFFFFF"
        android:textColorHint="#888888"
        android:inputType="text"
        android:background="#161625"
        android:padding="16dp"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/etRegPassword"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:hint="Password"
        android:textColor="#FFFFFF"
        android:textColorHint="#888888"
        android:inputType="textPassword"
        android:background="#161625"
        android:padding="16dp"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/etRegConfirmPassword"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:hint="Confirm Password"
        android:textColor="#FFFFFF"
        android:textColorHint="#888888"
        android:inputType="textPassword"
        android:background="#161625"
        android:padding="16dp"
        android:layout_marginBottom="32dp"/>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnExecuteRegister"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="CREATE ACCOUNT"
        android:textColor="#00E5FF"
        android:textStyle="bold"
        android:background="@drawable/cyber_card_bg"
        android:layout_marginBottom="16dp"/>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnBackToLogin"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="RETURN TO LOGIN"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:background="#333333"/>
</LinearLayout>