<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A10">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DESIGN GUIDELINES"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#00E5FF"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&amp; FREQUENTLY ASKED QUESTIONS"
                android:textSize="14sp"
                android:textColor="#AAAAAA"
                android:letterSpacing="0.1"
                android:layout_marginBottom="32dp"/>

            <!-- FAQ 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/cyber_card_bg"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1. Color Formats (CMYK vs RGB)"
                    android:textColor="#9D00FF"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Always submit your designs in CMYK color mode. RGB is meant for digital screens and will look dull or slightly discolored when printed on physical paper."
                    android:textColor="#DDDDDD"
                    android:lineSpacingExtra="4dp"
                    android:textSize="14sp"/>
            </LinearLayout>

            <!-- FAQ 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/cyber_card_bg"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2. Bleed Margins"
                    android:textColor="#9D00FF"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Include a 3mm 'bleed' around the edges of your artwork. This ensures that when the paper is cut, no accidental white borders appear. Keep all important text inside the safe zone."
                    android:textColor="#DDDDDD"
                    android:lineSpacingExtra="4dp"
                    android:textSize="14sp"/>
            </LinearLayout>

            <!-- FAQ 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/cyber_card_bg"
                android:padding="16dp"
                android:layout_marginBottom="32dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3. File Requirements"
                    android:textColor="#9D00FF"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="We accept high-resolution (300 DPI) PDF, PNG, and JPEG files. Please ensure all custom fonts are outlined, rasterized, or embedded in your PDF."
                    android:textColor="#DDDDDD"
                    android:lineSpacingExtra="4dp"
                    android:textSize="14sp"/>
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnEmailSupport"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="INITIATE SUPPORT TICKET (EMAIL)"
                android:textColor="#000000"
                android:textStyle="bold"
                android:backgroundTint="#00E5FF"
                android:layout_marginBottom="24dp"/>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>