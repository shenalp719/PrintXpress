<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Design Guidelines &amp; FAQs"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#3F51B5"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Color Formats (CMYK vs RGB)"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#333333"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Always design your files in CMYK color mode, not RGB. RGB is for digital screens, while CMYK is required for physical printing to ensure color accuracy."
            android:textSize="14sp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. Bleed Margins"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#333333"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Include a 3mm (0.125 inch) bleed on all edges of your artwork. This ensures no white borders are left after the paper is cut."
            android:textSize="14sp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3. File Requirements"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#333333"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• Preferred formats: High-resolution PDF, PNG, or TIFF.\n• Resolution: Minimum 300 DPI (Dots Per Inch) for crisp printing.\n• Convert all text to outlines/curves before saving."
            android:textSize="14sp"
            android:layout_marginBottom="32dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Still need help?"
            android:textStyle="bold"
            android:textSize="18sp"
            android:gravity="center"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnContactSupport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Email Customer Support"
            android:textSize="16sp"
            android:padding="12dp"
            android:backgroundTint="#FF9800"/>

    </LinearLayout>
</ScrollView>